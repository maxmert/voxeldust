# Rust build artifacts. `target-*` catches the scratch build dirs a side-by-side check creates
# (e.g. a second tree built to compare against HEAD) — one of those reached 2.3 GB untracked.
/target/
/target-*/
**/target/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Database files (runtime-generated)
*.redb

# HR6 agent E2E runs (screenshots, video frames, state dumps)
/runs/

# Coverage profiles (HR5)
*.profraw
*.profdata

# Docker/K8s runtime
*.tar

# Claude Code
.claude/
