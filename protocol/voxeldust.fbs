namespace voxeldust.protocol;

// ============================================================
// Shared primitives
// ============================================================

struct Vec3d {
    x: double;
    y: double;
    z: double;
}

struct Quatd {
    x: double;
    y: double;
    z: double;
    w: double;
}

struct Vec3f {
    x: float;
    y: float;
    z: float;
}

struct Quatf {
    x: float;
    y: float;
    z: float;
    w: float;
}

// ============================================================
// Inter-shard messages (QUIC)
// ============================================================

/// Galaxy context for handoffs between galaxy and system shards.
table GalaxyHandoffContext {
    galaxy_seed: uint64;
    star_index: uint32;
    star_position: Vec3d;
}

table PlayerHandoff {
    session_token: uint64;
    player_name: string;
    position: Vec3d;
    velocity: Vec3d;
    rotation: Quatd;
    forward: Vec3d;
    fly_mode: bool;
    speed_tier: uint8;
    grounded: bool;
    health: float;
    shield: float;
    source_shard_id: uint64;
    source_tick: uint64;
    /// For galaxy→system handoffs: target star index (0xFFFFFFFF = not set).
    target_star_index: uint32 = 4294967295;
    /// For system→galaxy handoffs: galaxy context for coordinate transform.
    galaxy_context: GalaxyHandoffContext;
    /// Target planet seed (0xFFFFFFFFFFFFFFFF = not set).
    target_planet_seed: uint64 = 18446744073709551615;
    /// Target planet index (0xFFFFFFFF = not set).
    target_planet_index: uint32 = 4294967295;
    /// Target ship ID for re-entry (0xFFFFFFFFFFFFFFFF = not set).
    target_ship_id: uint64 = 18446744073709551615;
    /// Target ship shard ID (0xFFFFFFFFFFFFFFFF = not set).
    target_ship_shard_id: uint64 = 18446744073709551615;
    /// Ship system-space position at handoff time.
    ship_system_position: Vec3d;
    /// Ship rotation at handoff time.
    ship_rotation: Quatd;
    /// System shard celestial time for time synchronization.
    game_time: float64;
    /// For system→galaxy warp: target star index (0xFFFFFFFF = not set).
    warp_target_star_index: uint32 = 4294967295;
    /// For system→galaxy warp: velocity in galaxy units/s.
    warp_velocity: Vec3d;
    /// Ship→system EVA exit: player leaves ship hull in space.
    /// When true, the system shard spawns an EVA player entity.
    target_system_eva: bool = false;
    /// Schema version for character_state blob.
    /// 0 = legacy/absent (pre-Phase-A handoffs); 1 = Phase-A (KCC migration,
    /// blob always empty but reserved). Bump when blob layout changes
    /// incompatibly. Old shards reading new wire see default 0 → reconstruct
    /// character defaults; new shards reading old wire see 0 → same path.
    schema_version: uint16 = 0;
    /// Zstd-compressed, tag-keyed serialization of future character components
    /// (Stamina, EquipmentLoad, ActiveItem, DamageResistance). Layout is
    /// append-only, gated by CharacterComponentTag. Empty today; reserved
    /// so gameplay landings don't re-touch wire format.
    character_state: [ubyte];
}

table HandoffAccepted {
    session_token: uint64;
    target_shard_id: uint64;
    /// Target shard's authoritative spawn pose — the position/rotation/velocity
    /// where the target ACTUALLY placed the player entity (using its current
    /// ship pose, not the stale pose from `PlayerHandoff`). The source shard
    /// forwards these in its `ShardRedirectMsg` to the client so the client's
    /// first post-transition frame matches the target's broadcast exactly.
    has_spawn_pose: bool = false;
    spawn_position: Vec3d;
    spawn_rotation: Quatd;
    spawn_velocity: Vec3d;
}

table GhostUpdate {
    session_token: uint64;
    position: Vec3d;
    rotation: Quatd;
    velocity: Vec3d;
    tick: uint64;
}

table ShardHeartbeat {
    shard_id: uint64;
    tick_ms: float;
    p99_tick_ms: float;
    player_count: uint32;
    chunk_count: uint32;
}

table SplitDirective {
    target_shard_id: uint64;
    /// Sectors to hand off to a new shard.
    sectors_to_split: [uint8];
    /// Seed for provisioning the new shard.
    planet_seed: uint64;
}

table MergeDirective {
    absorbing_shard_id: uint64;
    merging_shard_id: uint64;
    /// Sectors being transferred to the absorbing shard.
    sectors: [uint8];
}

table CrossShardBlockEdits {
    /// Chunk address bytes (sector, shell, cx, cy, cz).
    chunk_address: [uint8];
    /// Block edits: 5 bytes each (bx, by, bz, block_type_lo, block_type_hi).
    edits: [uint8];
    /// Monotonic sequence number for this chunk.
    seq: uint64;
}

/// Ship physical properties derived from block composition.
/// Sent from ship shard → system shard when blocks change.
table ShipPropertiesUpdate {
    ship_id: uint64;
    mass_kg: double;
    max_thrust_forward_n: double;
    max_thrust_reverse_n: double;
    max_torque_nm: double;
    thrust_multiplier: double;
    dimensions_x: double;
    dimensions_y: double;
    dimensions_z: double;
}

/// Server-authoritative autopilot state snapshot.
table AutopilotSnapshot {
    phase: uint8;                     // FlightPhase as u8
    mode: uint8;                      // AutopilotMode as u8
    target_planet_index: uint32 = 4294967295;
    thrust_tier: uint8;
    intercept_pos: Vec3d;
    target_arrival_vel: Vec3d;
    braking_committed: bool;
    eta_real_seconds: double;
    target_orbit_altitude: double;
}

table ShipPositionUpdate {
    ship_id: uint64;
    position: Vec3d;
    velocity: Vec3d;
    rotation: Quatd;
    angular_velocity: Vec3d;
    autopilot: AutopilotSnapshot;
    /// Authoritative atmosphere state from system-shard physics.
    in_atmosphere: bool;
    atmosphere_planet_index: int32 = -1;
    /// Gravitational acceleration at ship position (m/s²), world frame.
    gravity_acceleration: Vec3d;
    /// Atmospheric density at ship altitude (kg/m³), 0 if not in atmosphere.
    atmosphere_density: double;
}

/// Pilot control input sent from ship shard to system shard.
/// Translates player input inside the ship into thrust/rotation
/// commands applied to the ship's rigid body in the system shard.
table ShipControlInput {
    ship_id: uint64;
    /// Thrust vector in ship-local coordinates.
    thrust: Vec3d;
    /// Desired rotation torque.
    torque: Vec3d;
    /// Whether the ship is braking (retrograde thrust).
    braking: bool;
    /// Tick number on the ship shard.
    tick: uint64;
}

/// Autopilot command sent from ship shard to system shard.
table AutopilotCommand {
    ship_id: uint64;
    /// Target body id: 0 = star, 1..N = planets.
    /// 0xFFFFFFFF = disengage autopilot.
    target_body_id: uint32;
    /// Speed tier (0=maneuver, 1=impulse, 2=cruise, 3=long_range, 4=emergency).
    speed_tier: uint8;
    /// Autopilot mode: 0=DirectApproach, 1=OrbitInsertion, 2=Landing, 3=Takeoff, 4=Departure.
    autopilot_mode: uint8;
}

/// Host switch: tells a ship shard to change its physics host.
/// Sent by system shard (departure) or galaxy shard (arrival).
/// Includes full endpoint info for the ship shard to send ShardPreConnect
/// to the client (secondary UDP for dual-shard compositing).
table HostSwitch {
    ship_id: uint64;
    new_host_shard_id: uint64;
    new_host_quic_addr: string;
    new_host_tcp_addr: string;
    new_host_udp_addr: string;
    new_host_shard_type: uint8;   // 1=System, 3=Galaxy
    seed: uint64;                 // galaxy_seed or system_seed
}

/// Warp autopilot command sent from ship shard to system shard.
table WarpAutopilotCommand {
    ship_id: uint64;
    /// Target star index in the galaxy. 0xFFFFFFFF = disengage warp.
    target_star_index: uint32;
    galaxy_seed: uint64;
}

/// Ship position/state sent from system shard to planet shards within SOI.
table ShipNearbyInfo {
    ship_id: uint64;
    ship_shard_id: uint64;
    position: Vec3d;
    rotation: Quatd;
    velocity: Vec3d;
    game_time: float64;
}

// ---------------------------------------------------------------------------
// Phase 4.6: ShipNeighborhood — system-shard → ship-shard 1Hz push of the
// authoritative nearby-ships set for ShortRange signal routing.
//
// Today ship-shard learns peer positions opportunistically from incoming
// `SignalBroadcastBatch.source_position` headers — which means a ship that
// hasn't yet RECEIVED a signal from a peer doesn't know about that peer's
// position, and conservatively floods them. At dense traffic this is a
// real bandwidth + tick-budget cost.
//
// system-shard already has the spatial grid (Phase 4.5) and full position
// state. Pushing the authoritative neighborhood per ship eliminates the
// conservative-include surge: ship-shard's per-tick distance-prune now uses
// fresh, complete data.
//
// Cadence: 1 Hz. Ships move at most ~10s of meters per tick; a 1s lag on
// the neighborhood data is well under any ShortRange radius's transition
// window. The `position`/`velocity` fields let ship-shard inter/extrapolate
// for sub-second precision if the application wants it.
// ---------------------------------------------------------------------------

table ShipNeighborhoodEntry {
    /// The peer ship's `shard_id` (used as the QUIC routing key).
    peer_shard_id: uint64;
    /// The peer ship's authoritative position, stamped at the moment the
    /// system-shard built this batch. Receiver uses for ShortRange
    /// distance prune.
    peer_position: Vec3d;
    /// Peer velocity for optional client-side extrapolation between
    /// 1Hz pushes. Zero is a safe fallback.
    peer_velocity: Vec3d;
}

table ShipNeighborhood {
    /// The recipient ship's shard id — routed to this ship by the
    /// system-shard's QUIC dispatcher.
    target_ship_shard_id: uint64;
    /// UNIX millis when the system-shard built this batch. Allows
    /// the receiver to age-check + drop stale data after disconnect.
    issued_at_ms: uint64;
    /// Peers within the system-shard's chosen routing radius (today
    /// `max(ShortRange tier ranges) × hysteresis`). Self is excluded.
    peers: [ShipNeighborhoodEntry];
}

// ---------------------------------------------------------------------------
// Phase 5.1: Media (text/audio/video/image) data plane.
//
// Parallel to `SignalBroadcastBatch` for low-bitrate use (text + small
// frames). Audio + video at production rates want a dedicated QUIC
// stream per active subscription — that transport is a deferred slice;
// the wire shape below is the foundation both paths share.
//
// Auth: same as signal — `auth_tag` is HMAC over the canonical
// header bytes plus a hash of `payload_data`. Verify cost is O(hash)
// regardless of frame size, so a 25 KB video frame doesn't burn more
// CPU than a 30-byte text line.
//
// Codec selection: `codec` carries the `AudioCodec` / `VideoCodec` /
// `ImageFormat` ordinal corresponding to `payload_kind`. Mismatched
// codecs between publisher and subscriber fail at config time in the
// tablet UI — never a runtime transcode burden.
// ---------------------------------------------------------------------------

table MediaFrame {
    /// Channel name. Same `<owner>.<block-uid>.<role>` convention as
    /// the signal pipeline's channel namespace.
    channel_name: string;
    /// Capability lookup. Same semantics as
    /// `SignalBroadcastEntry::grant_id` — receiver verifies
    /// `auth_tag` against the matching grant's HMAC key.
    grant_id: uint64;
    /// Per-(channel, sender) monotonic sequence — drives the
    /// receiver's replay window. Same shape as signal entries.
    sequence: uint64;
    /// UNIX wall-clock millis at the publisher.
    timestamp_ms: uint64;
    /// Payload kind: 0=Text, 1=Audio, 2=Video, 3=Image.
    payload_kind: uint8;
    /// Codec ordinal per `payload_kind` (0 for Text). See
    /// `core::media::{AudioCodec, VideoCodec, ImageFormat}` for
    /// the numeric values — wire-stable, never reused.
    codec: uint8;
    /// Codec-specific encoded bytes. UTF-8 for Text; Opus packet
    /// for Audio; H.264 NAL unit / AV1 OBU for Video; PNG/JPEG
    /// stream for Image.
    payload_data: [uint8];
    /// Audio: sample count in this frame. Zero for other kinds.
    samples: uint32 = 0;
    /// Audio: sample rate (Hz). Zero for other kinds.
    sample_rate: uint32 = 0;
    /// Video / Image: width in pixels.
    width: uint32 = 0;
    /// Video / Image: height in pixels.
    height: uint32 = 0;
    /// Bit 0 (Video): keyframe (1 = I-frame, 0 = delta). Other
    /// kinds: 0.
    flags: uint8 = 0;
    /// HMAC-SHA256 truncated to 16 bytes. Auth input is
    /// `(canonical_header || sha256(payload_data))`.
    auth_tag: [uint8];
}

table MediaBroadcastBatch {
    source_shard_id: uint64;
    source_position: Vec3d;
    frames: [MediaFrame];
}

/// Kind of observable entity carried in WorldState.entities and AOI updates.
/// Ship: a physical ship grid. Identified by entity_id == ship_id.
/// EvaPlayer: a player floating in space (system shard authoritative).
/// GroundedPlayer: a player on a planet surface (planet shard authoritative).
/// Seated: a player seated inside a ship (ship shard authoritative).
enum EntityKind : byte {
    Ship = 0,
    EvaPlayer = 1,
    GroundedPlayer = 2,
    Seated = 3,
}

/// Unified observable entity for multi-shard AOI visibility.
/// Replaces per-type visibility messages (ShipSnapshotEntry, per-player snapshots)
/// with a single rendering-ready entry. Generated by the system-shard AOI pass
/// and included in every shard's WorldState broadcast.
table ObservableEntity {
    /// For ships: ship_id. For players: session_token.
    entity_id: uint64;
    kind: EntityKind;
    /// Position in the WorldState.origin frame (client adds origin).
    position: Vec3d;
    rotation: Quatd;
    /// Velocity in the same frame as position (for interpolation / dead reckoning).
    velocity: Vec3d;
    /// Approximate bounding radius (meters) for LOD + frustum culling.
    bounding_radius: float;
    /// 0=Full (0-2km ships / 0-200m players), 1=Reduced, 2=Coarse.
    lod_tier: uint8;
    /// Shard ID of the authoritative shard for this entity (for secondary upgrades).
    /// 0 if no secondary connection is beneficial.
    shard_id: uint64 = 0;
    /// Authoritative shard type (0=Planet, 1=System, 2=Ship, 3=Galaxy).
    shard_type: uint8 = 0;
    /// True for the player's own ship / avatar entry.
    is_own: bool = false;
    /// Player display name. Empty for ships without a pilot context.
    name: string;
    /// Player health (0 for non-player kinds).
    health: float = 0;
    /// Player shield (0 for non-player kinds).
    shield: float = 0;
    // -- Body / head decoupling (Phase A; player kinds only) --------
    // Same semantics as the matching fields on PlayerSnapshot. Always
    // present in the table to keep the FB layout uniform; clients that
    // render non-player kinds simply ignore these.
    body_yaw: float = 0;
    head_yaw: float = 0;
    head_pitch: float = 0;
    locomotion: uint8 = 0;
    locomotion_speed: float = 0;
    is_turning: bool = false;
    turn_target_yaw: float = 0;
    turn_t: float = 0;
    // -- Look-at attention target (Phase H; player kinds only) -----
    // World-space target the character is looking at, encoded as a
    // delta from `position` (so f32 precision is fine even for very
    // far-from-origin shards). `look_target_set = false` means no
    // target — the head returns to the animation pose. Defaults
    // preserve old-client behaviour (no look-at).
    look_target_set: bool = false;
    look_dx: float = 0;
    look_dy: float = 0;
    look_dz: float = 0;
    // -- Ragdoll bone snapshot (Phase I; player kinds only) ---------
    // Same semantics + format as `PlayerSnapshot.ragdoll_bones` —
    // duplicated here so the unified `ObservableEntity` ingestion
    // path on the client gets ragdoll data without needing a
    // second per-tick lookup against `PlayerSnapshot`.
    ragdoll_bones: [RagdollBoneSnapshot];
    // -- Tablet hold state (Phase J; player kinds only) -------------
    is_holding_tablet: bool = false;
    tablet_cursor_u: float = 0;
    tablet_cursor_v: float = 0;
}

/// System shard → ship/planet shard: AOI entity set for a single observer.
/// Replaces the ad-hoc mix of SystemSceneUpdate.ships + VisibilityDirective
/// + ShipNearbyInfo with a single authoritative stream.
table SystemEntitiesUpdate {
    /// If set, this update is for a ship shard hosting the ship with this id (0 = unset).
    target_ship_id: uint64 = 0;
    /// If set, this update is for the planet shard at this planet index
    /// (0xFFFFFFFF = unset — i.e., the update targets a ship shard).
    target_planet_index: uint32 = 4294967295;
    /// Observer anchor position in system coordinates (used for LOD tier computation).
    observer_position: Vec3d;
    /// Entities in the observer's AOI, ready for merging into WorldState.
    entities: [ObservableEntity];
    /// System-shard tick when this snapshot was taken.
    tick: uint64;
}

/// One player entry in a PlanetPlayerDigest.
table PlanetPlayerDigestEntry {
    session_token: uint64;
    player_name: string;
    /// System-space position (planet shard transforms before sending).
    position: Vec3d;
    rotation: Quatd;
    /// Planet index within the system (for fast filtering).
    planet_index: uint32;
}

/// Planet shard → system shard: aggregate positions of all surface players.
/// Sent at 1 Hz. Feeds the system shard's AOI so distant observers (ships, EVA)
/// can see players on planets without needing a full secondary connection.
table PlanetPlayerDigest {
    planet_shard_id: uint64;
    planet_seed: uint64;
    planet_index: uint32;
    entries: [PlanetPlayerDigestEntry];
    tick: uint64;
}

/// Stellar physical state — broadcast for stars (CelestialBodySnapshot
/// where body_id == 0, and every StarCatalogEntry). Server-side derivation
/// in `core::stellar::StellarState::from_class_and_seed`.
///
/// All fields are SI-unit physics values; the client renders directly from
/// these without re-deriving anything from the seed.
table StellarStateData {
    /// Mass in solar masses.
    mass_solar: float;
    /// Effective surface temperature in Kelvin.
    temperature_k: float;
    /// Radius in solar radii.
    radius_solar: float;
    /// Total radiative power in watts.
    luminosity_w: float;
    /// Pre-computed linear sRGB rendering colour, channels in [0, 1].
    /// (Server pre-computes via the Tanner-Helland blackbody approximation
    /// in `core::blackbody`, so the client doesn't need any colour-conversion
    /// dependency.)
    color_linear_r: float;
    color_linear_g: float;
    color_linear_b: float;
    /// Surface radiance σ·T⁴ in W/m² for HDR emissive sun-disk rendering.
    surface_radiance_w_per_m2: float;
}

/// Per-planet physics-derived geophysical state — broadcast for planets
/// (CelestialBodySnapshot where body_id != 0). Server-side derivation in
/// `core::geophysics::PlanetGeophysicalState::from_seed_and_star`.
///
/// All values are physics-derived from the planet seed plus the parent
/// star's `StellarState`. The client builds a Bevy 0.18 `ScatteringMedium`
/// and `Atmosphere` directly from these without re-deriving anything.
///
/// Composition fractions are mole-fractions and sum to ≈ 1 for atmosphered
/// planets; all zero for airless bodies (where `has_atmosphere == 0`).
table PlanetaryStateData {
    /// 1 if this planet retains an atmosphere on geological timescales;
    /// 0 if airless (low mass, hot, or seed-derived "lost atmosphere"
    /// outcome). When 0 the rest of the fields are still meaningful for
    /// future ground / weather work but the client suppresses any
    /// `Atmosphere` rendering.
    has_atmosphere: ubyte;

    // ─── Bulk planet physics ──────────────────────────────────────────────
    /// Surface gravity at the equator.
    /// Units: m · s⁻².
    surface_gravity_ms2: float;
    /// Equilibrium temperature from radiation balance with the parent star.
    /// Units: K.
    equilibrium_temp_k: float;
    /// Surface pressure of the atmosphere.
    /// Units: Pa.
    surface_pressure_pa: float;
    /// Bond albedo of the planet surface — used for `Atmosphere.ground_albedo`.
    /// Range: [0, 1], dimensionless.
    ground_albedo_r: float;
    ground_albedo_g: float;
    ground_albedo_b: float;

    // ─── Composition (mole fractions) ─────────────────────────────────────
    composition_n2: float;
    composition_o2: float;
    composition_co2: float;
    composition_ch4: float;
    composition_h2o: float;
    composition_h2: float;
    composition_he: float;
    composition_dust: float;

    // ─── Atmospheric vertical structure ───────────────────────────────────
    /// Pressure scale height H = R·T / (M̄·g).
    /// Units: m.
    scale_height_m: float;
    /// Altitude above the surface where atmosphere is treated as
    /// effectively zero density (Bevy's `Atmosphere::top_radius` minus
    /// `bottom_radius`). ~6 scale heights for ≈ 99.7 % column mass below.
    /// Units: m.
    atmosphere_top_altitude_m: float;
    /// Mean molecular mass of the atmospheric mixture.
    /// Units: kg per molecule.
    mean_molecular_mass_kg: float;
    /// Total atmospheric mass — used by server-side weather and atmospheric
    /// drag calculations.
    /// Units: kg.
    atmospheric_mass_kg: float;

    // ─── Rayleigh (molecular) scattering — per RGB ────────────────────────
    /// Per-band Rayleigh scattering coefficient at the surface.
    /// Units: m⁻¹.
    rayleigh_scattering_r: float;
    rayleigh_scattering_g: float;
    rayleigh_scattering_b: float;
    /// Scale height of the Rayleigh-scattering vertical profile (typically
    /// the same as `scale_height_m`; broadcast separately so future planets
    /// with stratified composition can decouple them).
    /// Units: m.
    rayleigh_scale_height_m: float;

    // ─── Mie (aerosol/dust) scattering ────────────────────────────────────
    /// Per-band Mie scattering coefficient at the surface (typically grey,
    /// but tinted for dust / sulfate atmospheres).
    /// Units: m⁻¹.
    mie_scattering_r: float;
    mie_scattering_g: float;
    mie_scattering_b: float;
    /// Per-band Mie absorption coefficient at the surface.
    /// Units: m⁻¹.
    mie_absorption_r: float;
    mie_absorption_g: float;
    mie_absorption_b: float;
    /// Mie scattering scale height — aerosols sit closer to the ground
    /// than gas molecules; defaults to ~1.2 km but can vary.
    /// Units: m.
    mie_scale_height_m: float;
    /// Henyey-Greenstein phase asymmetry for the Mie term.
    /// Range: [-1, 1]; positive ≈ forward-scattering.
    mie_phase_g: float;

    // ─── Ozone absorption — per RGB ───────────────────────────────────────
    /// Per-band ozone absorption coefficient at the layer centre. Zero for
    /// planets that don't form an ozone layer (insufficient O₂ or
    /// insufficient UV from a cool star).
    /// Units: m⁻¹.
    ozone_absorption_r: float;
    ozone_absorption_g: float;
    ozone_absorption_b: float;
    /// Ozone-layer geometry: centre altitude and total width.
    /// Units: m.
    ozone_layer_centre_m: float;
    ozone_layer_width_m: float;
}

/// Per-planet rotation parameters — broadcast for planets
/// (`body_id != 0`). Static for the planet's session lifetime; both
/// server and client evaluate the same closed-form
/// `core::planet_rotation::rotation_at(params, game_time)` per frame so
/// every viewer sees the same rotation phase at every wall-clock moment.
table PlanetRotationParamsData {
    /// Sidereal rotation period (seconds). Derived in
    /// `core::planet_rotation::PlanetRotationParams::from_seed_and_state`
    /// from the planet's gravitational free-fall timescale plus a
    /// log-uniform seed-driven formation-history multiplier.
    period_s: double;
    /// Rotation axis in the system's inertial frame. Unit vector.
    /// Retrograde rotation is encoded as a flipped axis (negative Z).
    axis_x: double;
    axis_y: double;
    axis_z: double;
    /// Phase offset at `game_time = 0`. Picked from the planet seed so
    /// neighbour planets aren't synchronised at boot.
    epoch_offset_s: double;
}

/// Snapshot of a celestial body's state for scene rendering.
table CelestialBodySnapshot {
    body_id: uint32;       // 0 = star, 1..N = planets
    position: Vec3d;       // in system coordinates (meters)
    radius: double;        // meters
    color_r: float;
    color_g: float;
    color_b: float;
    /// Optional physics-derived stellar state. Populated for stars
    /// (body_id == 0) by every shard that broadcasts the body.
    stellar: StellarStateData;
    /// Optional physics-derived planetary state. Populated for planets
    /// (body_id != 0) by every shard that broadcasts the body. The client
    /// builds Bevy 0.18 `ScatteringMedium` + `Atmosphere` directly from
    /// these fields.
    planetary: PlanetaryStateData;
    /// Optional rotation parameters for planets (`body_id != 0`). Static
    /// for the planet's session lifetime; client evaluates
    /// `rotation_at(params, game_time_now)` each frame to drive the
    /// shard origin's rotation (sunrise/sunset emerges from the existing
    /// per-camera sun-direction recomputation).
    rotation_params: PlanetRotationParamsData;
}

/// Snapshot of a ship's state for scene rendering.
table ShipSnapshotEntry {
    ship_id: uint64;
    position: Vec3d;
    rotation: Quatd;
    is_own_ship: bool;     // true for the player's own ship
}

/// Lighting parameters computed by server.
table LightingInfoMsg {
    sun_direction: Vec3d;  // normalized, toward star
    sun_color_r: float;
    sun_color_g: float;
    sun_color_b: float;
    sun_intensity: float;
    ambient: float;
}

/// Scene update sent from system shard to ship/planet shards.
/// Contains positions of all celestial bodies and ships for rendering.
table SystemSceneUpdate {
    game_time: double;
    bodies: [CelestialBodySnapshot];
    ships: [ShipSnapshotEntry];
    lighting: LightingInfoMsg;
}

/// Cross-shard signal broadcast — single signal (legacy, kept for backward compat).
table SignalBroadcast {
    source_shard_id: uint64;
    channel_name: string;
    /// Signal value type: 0=Bool, 1=Float, 2=State
    value_type: uint8;
    /// Signal value data (bool as 0.0/1.0, state as float cast).
    value_data: float;
    /// Scope: 1=ShortRange, 2=LongRange, 3=Radio
    scope: uint8;
    /// Range in meters (for ShortRange proximity check).
    range_m: double;
    /// World position of the broadcasting antenna (for distance checks).
    source_position: Vec3d;
}

/// A single signal entry within a batched broadcast.
table SignalBroadcastEntry {
    channel_name: string;
    /// Signal value type: 0=Bool, 1=Float, 2=State
    value_type: uint8;
    /// Signal value data (bool as 0.0/1.0, state as float cast).
    value_data: float;
    /// Scope: 1=ShortRange, 2=LongRange, 3=Radio
    scope: uint8;
    /// Range in meters (ShortRange only; 0.0 for LongRange/Radio).
    range_m: double;
    /// Radio frequency (Radio scope only; 0 for other scopes).
    frequency: uint32;
    // -- Phase 2 wire-protocol additions (additive, optional) ----------
    /// Per-(channel, sender) monotonic sequence — drives the receiver's
    /// 64-entry replay window. Senders increment this per outbound
    /// publish on the same channel. Default 0 means "legacy sender,
    /// don't enforce replay" — receivers gate the check on `seq != 0 ||
    /// timestamp_ms != 0` so old↔new shards interoperate cleanly.
    sequence: uint64 = 0;
    /// UNIX wall-clock millis at the sender. The receiver compares against
    /// its own clock and rejects entries whose drift exceeds
    /// `REPLAY_TIMESTAMP_WINDOW_MS` (5 s). Default 0 → "legacy".
    timestamp_ms: uint64 = 0;
    /// Phase 3 capability lookup. Non-zero → look up the grant by id in
    /// the receiver's `GrantsRegistry`, verify `auth_tag` against the
    /// grant's HMAC key, and (if scope is Local) treat the grant as the
    /// proof of authorized cross-shard access. Default 0 → "open
    /// broadcast, no grant" — Phase 1A's `LocalChannelImmutable` still
    /// rejects Local-scoped channels reached this way.
    grant_id: uint64 = 0;
    /// Phase 3 HMAC-SHA256 truncated to 16 bytes. Empty → unauthenticated.
    /// Receiver verifies against `channel.signature` (or grant.key if
    /// `grant_id != 0`) over the canonicalized payload bytes.
    auth_tag: [uint8];
}

/// Batched signal broadcast — multiple signals in one message.
/// Reduces QUIC sends from (signals × peers) to (peers) per tick.
table SignalBroadcastBatch {
    source_shard_id: uint64;
    /// World position of the broadcasting structure.
    source_position: Vec3d;
    /// All dirty signals in this batch.
    entries: [SignalBroadcastEntry];
}

// ---------------------------------------------------------------------------
// Phase 4.3: wire-dictionary interning. V2 entries replace the verbose
// `channel_name: string` with a per-connection `wire_id: uint32` plus a
// FLAG_REGISTER bit that announces the (wire_id, name) binding the first
// time the sender mentions a channel to a given peer. The receiver builds
// up an `InboundDict` and looks up the name on subsequent references.
// Steady-state savings: ~30B name → 4B id ≈ 3-5× wire-size reduction.
//
// V2 coexists with V1 during rolling deployments. Senders use V2 only
// when the peer's `signal_dict_v2` capability is registered (handshake
// not yet implemented — for now, V2 is opt-in per-shard via config).
// ---------------------------------------------------------------------------

table SignalBroadcastEntryV2 {
    /// Bit 0 = FLAG_REGISTER: the entry carries a fresh `wire_id → name`
    /// binding. The receiver inserts/overwrites in its inbound dict
    /// before resolving. Bits 1-7 reserved for future use.
    flags: uint8;
    /// Per-connection dictionary id assigned by the sender.
    wire_id: uint32;
    /// Channel name. Required when FLAG_REGISTER is set; ignored
    /// otherwise (kept on the wire as empty string for FB schema
    /// uniformity, but receivers MUST NOT trust this field unless
    /// FLAG_REGISTER is set on the entry).
    channel_name: string;
    /// Same payload semantics as V1.
    value_type: uint8;
    value_data: float;
    scope: uint8;
    range_m: double;
    frequency: uint32;
    sequence: uint64 = 0;
    timestamp_ms: uint64 = 0;
    grant_id: uint64 = 0;
    auth_tag: [uint8];
}

table SignalBroadcastBatchV2 {
    source_shard_id: uint64;
    source_position: Vec3d;
    /// Sender's `OutboundDict::dict_seq()` at batch-build time. Receiver
    /// gates the batch on `dict_seq >= last_accepted` (monotonic). A
    /// drift triggers full resync (drop batch + clear inbound dict +
    /// log + bump `signal_dict_resync_total`).
    dict_seq: uint64;
    entries: [SignalBroadcastEntryV2];
}

// ---------------------------------------------------------------------------
// Phase 3F: galaxy-shard signal_relay subscribe protocol.
//
// The galaxy-shard fans out Radio-scope (`scope=3`) signal batches to
// system-shards that have explicitly registered as subscribers. Without
// a subscription the relay drops Radio traffic at galaxy — operators
// can verify by chart-watching `signal_relay_skipped_no_subscribers`.
//
// Two ways for a system-shard to register interest:
//   1. **Per-frequency**: list specific `frequencies`. Galaxy fans out
//      only batches whose entries match one of those frequencies.
//   2. **Wildcard**: set `wildcard=true`. Galaxy fans out every Radio
//      batch to this shard. Costs more bandwidth but trivially correct
//      and is the MVP default — ships' Listener blocks don't yet
//      propagate per-frequency interest to their system-shard.
//
// A subscription carries `lease_until_ms` (UNIX millis). The galaxy
// expires subscribers automatically — sender must re-subscribe before
// the deadline. Unix-time keeps the lease independent of per-shard
// tick counters which don't share epoch.
// ---------------------------------------------------------------------------

table RadioSubscribe {
    /// The shard the galaxy should forward matching batches to. Usually
    /// a system-shard; could be any shard that wants to receive.
    subscriber_shard_id: uint64;
    /// Specific frequencies to subscribe to. Empty when `wildcard` is
    /// set (then the field is unused).
    frequencies: [uint32];
    /// True ⇒ subscribe to every Radio batch regardless of frequency.
    /// Used by system-shards as a coarse default until per-frequency
    /// listener-tracking lands (deferred).
    wildcard: bool;
    /// UNIX millis after which the subscription auto-expires unless
    /// renewed. Galaxy compares against its own clock — sender + receiver
    /// must have approximately synchronized wall-clock time (NTP).
    lease_until_ms: uint64;
}

table RadioUnsubscribe {
    subscriber_shard_id: uint64;
    /// Frequencies to drop. Ignored when `wildcard` is set (then the
    /// shard's wildcard subscription is dropped).
    frequencies: [uint32];
    wildcard: bool;
}

// ---------------------------------------------------------------------------
// Phase 3F.9: ship-shard → system-shard interest propagation.
//
// A ship-shard tells its host system-shard which Radio frequencies it
// has Listener blocks for. The system-shard aggregates across all ships
// it hosts and sends a precise per-frequency `RadioSubscribe` to the
// galaxy. Without this hop, a system-shard subscribes to galaxy as a
// wildcard ("send me every Radio batch") which scales poorly at 100K-
// user load.
//
// Full-set semantics: each `ShipFrequencyInterest` message carries the
// COMPLETE current set of frequencies for that ship, not a delta. The
// system-shard's tracker overwrites the ship's entry on every receive.
// This makes the protocol self-healing: a missed message just delays
// convergence by one renewal cycle (90s); there's no diff state to lose.
//
// Lease + renewal: `lease_until_ms` is UNIX millis. Ship-shard renews
// every 30s with a 90s lease (3× headroom for jitter). System-shard
// drops a ship's interest after the lease expires — handles
// disconnects + crashes without explicit teardown messaging.
// ---------------------------------------------------------------------------

table ShipFrequencyInterest {
    /// The ship-shard that holds the listeners.
    ship_shard_id: uint64;
    /// All frequencies this ship has at least one Listener block for.
    frequencies: [uint32];
    /// UNIX millis lease deadline. System-shard drops this ship's
    /// entry on expiry.
    lease_until_ms: uint64;
}

// ---------------------------------------------------------------------------
// Phase 3D: cross-shard subscribe protocol. Lets a foreign shard register
// interest in a channel hosted on this shard. The receiving shard records
// the subscription as `SubscriberRef::RemoteShard` on the channel; future
// dirty values get forwarded as grant-stamped `SignalBroadcastEntry`s.
// ---------------------------------------------------------------------------

/// Subscribe request — the sender wants this shard to forward dirty values
/// for `channel_name` until `valid_until_tick`. Authorized via `grant_id`
/// + `auth_tag` (HMAC under the grant's key, see
/// `signal::auth::hmac_sign_subscribe_request`).
table SignalSubscribe {
    /// Subscriber's shard id — the destination of forwarded entries.
    subscriber_shard_id: uint64;
    /// Full namespaced channel name on this shard (`<owner>.<path>`).
    channel_name: string;
    /// Grant authorizing the subscription. Receiver looks up the grant
    /// in `GrantsRegistry::check_subscribe`.
    grant_id: uint64;
    /// Fresh per-request nonce — defends against replay of subscribe
    /// requests within the timestamp window.
    nonce: uint64;
    /// UNIX millis at the sender. Receiver enforces ±5s freshness.
    timestamp_ms: uint64;
    /// Lease deadline in receiver-local tick numbers. Receiver caps
    /// against a max-lease ceiling so a malicious request can't request
    /// "valid until tick 2^64".
    valid_until_tick: uint64;
    /// HMAC-SHA256 over the canonical request bytes, truncated to 16
    /// bytes. Verified under `grants_registry.check_subscribe(grant_id)`'s
    /// returned key.
    auth_tag: [uint8];
}

/// Unsubscribe — explicit teardown. Idempotent.
table SignalUnsubscribe {
    subscriber_shard_id: uint64;
    channel_name: string;
    grant_id: uint64;
}

// Union of all inter-shard message payloads.
/// Entry in a VisibilityDirective — one visible ship with connection info.
table VisibleShipEntry {
    ship_id: uint64;
    shard_id: uint64;
    tcp_addr: string;
    udp_addr: string;
    distance: double;
}

/// System shard → ship shard: which other ships are visible to this ship.
/// Sent when the visibility set changes (enter/leave events).
table VisibilityDirective {
    ship_id: uint64;               // The ship being directed
    visible_ships: [VisibleShipEntry];
}

/// A single collider shape (axis-aligned box): center position + half-extents.
/// Packed as 6 floats for minimal wire overhead.
struct ColliderShape {
    cx: float;  // center x
    cy: float;  // center y
    cz: float;  // center z
    hx: float;  // half-extent x
    hy: float;  // half-extent y
    hz: float;  // half-extent z
}

/// Per-chunk collider shapes for one chunk of a ship grid.
table ChunkColliderDataMsg {
    cx: int32;                     // chunk key x
    cy: int32;                     // chunk key y
    cz: int32;                     // chunk key z
    shapes: [ColliderShape];       // (center, half_extents) pairs
}

/// Per-chunk interior-volume bitmask. `interior_bits` is a packed bit array
/// of length `CHUNK_INTERIOR_WORDS` (3724 u64s = 238328 bits, one per voxel)
/// matching `palette::block_index(x,y,z)`. A set bit means the voxel is
/// interior — i.e. inside the ship's hull, reachable from a seat, and
/// geometrically enclosed. Used by the host shard for O(1) boarding checks
/// and by the ship shard for exit checks.
table InteriorChunkBitsMsg {
    cx: int32;                     // chunk key x
    cy: int32;                     // chunk key y
    cz: int32;                     // chunk key z
    interior_bits: [uint64];       // packed bit array, one bit per voxel
}

/// Ship shard → host shard: full set of collider shapes for the ship hull,
/// plus the per-chunk interior-volume mask.
/// Sent on startup and when blocks change. The host shard builds Rapier
/// compound colliders from these shapes for physical collision AND keeps
/// the interior mask for boarding-detection queries.
table ShipColliderSync {
    ship_id: uint64;
    chunks: [ChunkColliderDataMsg];
    hull_min_x: float;             // AABB min corner
    hull_min_y: float;
    hull_min_z: float;
    hull_max_x: float;             // AABB max corner
    hull_max_y: float;
    hull_max_z: float;
    interior_chunks: [InteriorChunkBitsMsg];
}

union ShardPayload {
    PlayerHandoff,
    HandoffAccepted,
    GhostUpdate,
    ShardHeartbeat,
    SplitDirective,
    MergeDirective,
    CrossShardBlockEdits,
    ShipPositionUpdate,
    ShipControlInput,
    SystemSceneUpdate,
    AutopilotCommand,
    ShipNearbyInfo,
    WarpAutopilotCommand,
    HostSwitch,
    ShipPropertiesUpdate,
    SignalBroadcast,
    SignalBroadcastBatch,
    /// Phase 4.3: wire-dict-interned batch.
    SignalBroadcastBatchV2,
    VisibilityDirective,
    ShipColliderSync,
    /// System shard → ship/planet shard: unified AOI entity set.
    SystemEntitiesUpdate,
    /// Planet shard → system shard: aggregate surface-player positions at 1 Hz.
    PlanetPlayerDigest,
    /// Phase 3D: foreign shard subscribes to a channel on this shard via
    /// a held grant. Receiver registers a `SubscriberRef::RemoteShard` and
    /// forwards future dirty values until lease expiry.
    SignalSubscribe,
    /// Phase 3D: explicit subscribe teardown.
    SignalUnsubscribe,
    /// Phase 3F: register interest in Radio traffic at the galaxy
    /// shard. The galaxy holds the subscription until `lease_until_ms`
    /// or until matching `RadioUnsubscribe`.
    RadioSubscribe,
    /// Phase 3F: drop Radio interest.
    RadioUnsubscribe,
    /// Phase 3F.9: ship-shard → system-shard freq interest propagation.
    ShipFrequencyInterest,
    /// Phase 4.6: system-shard → ship-shard authoritative neighborhood
    /// for ShortRange signal routing (1 Hz cadence).
    ShipNeighborhood,
    /// Phase 5.1: media (text/audio/video/image) batched broadcast.
    /// Reuses signal's auth + replay-window + scope routing.
    MediaBroadcastBatch,
}

/// Root type for all inter-shard QUIC messages.
table ShardMessage {
    payload: ShardPayload;
}

// ============================================================
// Client ↔ Server messages (TCP/UDP)
// ============================================================

table Connect {
    player_name: string;
    /// Optional ship-grouping key. When non-empty, the gateway hashes
    /// THIS string instead of `player_name` to derive the ship_id —
    /// so two distinct players sharing the same `ship_join_key` land
    /// on the same ship shard. Empty (the default) preserves the
    /// legacy per-player-hash behaviour: every fresh player spawns on
    /// their own ship. Used by playtests / multi-client dev sessions
    /// (`--ship-join NAME`) and the future "join my ship" social
    /// flow. Never collapses sessions: the session store stays keyed
    /// on `player_name`, so distinct players always retain distinct
    /// identities even when they share a ship.
    ship_join_key: string;
}

table JoinResponse {
    seed: uint64;
    planet_radius: uint32;
    player_id: uint64;
    spawn_position: Vec3d;
    spawn_rotation: Quatd;
    spawn_forward: Vec3d;
    session_token: uint64;
    shard_type: uint8; // 0=Planet, 1=System, 2=Ship, 3=Galaxy
    galaxy_seed: uint64;
    system_seed: uint64;
    game_time: double;
    /// Origin of the local coordinate frame in system coords.
    reference_position: Vec3d;
    /// Rotation of the local frame (ship rotation or identity).
    reference_rotation: Quatd;
}

/// Single star entry in the galaxy catalog.
table StarCatalogEntry {
    index: uint32;
    position: Vec3d;
    system_seed: uint64;
    star_class: uint8;  // 0=O, 1=B, 2=A, 3=F, 4=G, 5=K, 6=M
    luminosity: float;
    /// Physics-derived stellar state — populated by galaxy-shard at galaxy
    /// generation via `core::stellar::StellarState::from_class_and_seed`.
    /// Optional for backwards compatibility with older catalog snapshots.
    stellar: StellarStateData;
}

/// Star catalog sent from galaxy shard to client on join.
table StarCatalog {
    galaxy_seed: uint64;
    stars: [StarCatalogEntry];
}

table PlayerInput {
    movement_x: float;
    movement_y: float;
    movement_z: float;
    look_yaw: float;
    look_pitch: float;
    jump: bool;
    fly_toggle: bool;
    orbit_stabilizer_toggle: bool;
    speed_tier: uint8;
    action: uint8; // 0=none, 1=break, 2=place
    block_type: uint16;
    tick: uint64;
    thrust_limiter: float = 0.75; // 0.0–1.0, default 75%
    roll: float;                  // Q/E: -1.0 (CCW) to +1.0 (CW)
    cruise: bool;                 // C key: supercruise active (legacy)
    atmo_comp: bool;              // H key: atmosphere compensation active (legacy)
    seat_values: [float];         // Per-binding float values when seated (generic seat)
    /// Bit-packed action modifiers. Reserved bits (MSB→LSB order, stable):
    ///   bit 0 = SPRINT
    ///   bit 1 = CROUCH
    ///   bit 2 = PRONE
    ///   bit 3 = STANCE_CYCLE_UP
    ///   bit 4 = STANCE_CYCLE_DOWN
    ///   bit 5 = INTERACT_ALT (future — alt-fire, throw)
    ///   bits 6..31 reserved — add new bits at the end of the used range,
    ///   never repurpose an assigned bit.
    ///
    /// Default 0 preserves legacy behaviour; old clients transmit nothing
    /// for this field and servers read 0 (no sprint/crouch).
    actions_bits: uint32 = 0;
}

table PlayerSnapshot {
    player_id: uint64;
    position: Vec3d;
    rotation: Quatd;
    velocity: Vec3d;
    grounded: bool;
    health: float;
    shield: float;
    seated: bool;       // player is in any seat (pilot, gunner, passenger)
    // -- Body / head decoupling (Phase A) ---------------------------
    // All angles in radians, in the player's local tangent frame
    // (planet) or ship-local Y-up (ship interior). Together with the
    // existing `rotation` field they let observers render the same
    // body-vs-head pose as the owning client. Defaults to 0/false so
    // older clients that don't read these fields stay correct: the
    // identity body orientation + neutral head pose.
    body_yaw: float = 0;
    head_yaw: float = 0;     // relative to body, ±class.head_yaw_limit
    head_pitch: float = 0;   // ±class.head_pitch_limit
    /// `voxeldust_core::character::LocomotionState as u8`:
    /// 0=Grounded, 1=Airborne, 2=Seated, 3=Climbing, 4=Ragdoll.
    /// Distinct from `grounded: bool` (which is a coarse two-state
    /// view); animation graph drives clip selection from this byte.
    locomotion: uint8 = 0;
    locomotion_speed: float = 0;   // m/s — drives walk/run blend
    /// True when the player is mid-turn-in-place; `turn_target_yaw`
    /// and `turn_t` are only meaningful in that case.
    is_turning: bool = false;
    turn_target_yaw: float = 0;    // absolute body_yaw target (rad)
    turn_t: float = 0;             // 0..1 progress through TIP clip
    // -- Look-at attention target (Phase H) -------------------------
    // World-space target this character is looking at, encoded as a
    // delta from `position` (f32 deltas keep precision even for very
    // far-from-origin shards). `look_target_set = false` means no
    // target — head stays in animation pose.
    look_target_set: bool = false;
    look_dx: float = 0;
    look_dy: float = 0;
    look_dz: float = 0;
    // -- Ragdoll bone snapshot (Phase I) ----------------------------
    // Per-bone world transforms streamed during the active ragdoll
    // window (`locomotion == Ragdoll`). Empty / absent in any other
    // state. Position is in the same shard-local frame as
    // `position`; rotation is a unit quaternion. Bone identity is by
    // name (Mixamo convention) so the wire format survives changes
    // to the per-class ragdoll skeleton spec.
    //
    // Future quantization (~6 bytes / bone) is a follow-up; today we
    // ship full f32 to keep the codec simple while the system is
    // exercised.
    ragdoll_bones: [RagdollBoneSnapshot];
    // -- Tablet hold state (Phase J) --------------------------------
    // `is_holding_tablet = true` when the server has accepted a
    // TabletInteractRequest from this character. Cursor UV is in
    // tablet-screen space [0, 1]. Both fall back to defaults
    // (false / 0) for old senders.
    is_holding_tablet: bool = false;
    tablet_cursor_u: float = 0;
    tablet_cursor_v: float = 0;
}

/// Per-bone transform during ragdoll simulation. See
/// `PlayerSnapshot.ragdoll_bones`.
table RagdollBoneSnapshot {
    /// Mixamo-convention bone name (e.g. `mixamorig:LeftLeg`).
    bone_name: string;
    /// Translation in shard-local coords.
    pos_x: float = 0;
    pos_y: float = 0;
    pos_z: float = 0;
    /// Unit quaternion (XYZW).
    rot_x: float = 0;
    rot_y: float = 0;
    rot_z: float = 0;
    rot_w: float = 1;
}

/// Transform of a mechanical sub-grid (rotor, piston, hinge, slider) body.
table SubGridTransform {
    sub_grid_id: uint32;
    translation: Vec3f;   // world-space position of child body (after parent chain)
    rotation: Quatf;      // world-space rotation of child body (after parent chain)
    parent_grid: uint32;  // 0 = root, >0 = nested parent sub-grid
    anchor: Vec3f;        // original root-space anchor (mount_pos + face offset, never changes)
    mount_x: int32;       // mount block position (for mechanism arm rendering)
    mount_y: int32;
    mount_z: int32;
    mount_face: uint8;    // face direction 0-5 (determines arm axis)
    joint_type: uint8;    // 0=revolute, 1=prismatic
    current_value: float; // current angle (deg) or extension (m)
}

/// Server-authored HUD signal snapshot entry. A superset of the
/// numeric-only core `SignalValue` — HUD widgets read strings too
/// (body names, warp targets, ship callsigns) and the server is
/// authoritative for all of them. Clients NEVER look up these strings
/// locally.
///
/// Value encoding:
///   value_type == 0 → Bool  (value_num: 0.0 or 1.0)
///   value_type == 1 → Float (value_num: as-is)
///   value_type == 2 → State (value_num: u8 cast to float)
///   value_type == 3 → Text  (value_text populated; value_num ignored)
table HudSignalEntry {
    channel_name: string;
    value_type: uint8;
    value_num: float;
    /// Only populated when value_type == 3.
    value_text: string;
    /// `SignalProperty` ordinal (0=Active, 1=Throttle, 2=Angle, …,
    /// 10=Text). Widget code uses this to pick a display format.
    property: uint8;
}

// ---------------------------------------------------------------------------
// Phase 4.4: delta-encoded HUD signal updates over TCP.
//
// Today's `WorldState.hud_signals` ships a FULL snapshot every tick
// over UDP. At 100K users × ~50 channels × ~50B × 20 Hz that's ~5 GB/s
// of HUD bandwidth alone. The vast majority is unchanged values
// re-serialized every tick.
//
// V2 path:
//   * Per-session `OutboundDict` interns channel names → `wire_id`.
//   * Server emits `HudSignalDelta` ONLY when something changed.
//   * Each `HudSignalEntryV2` is one of:
//       - **Register**: bit 0 of `flags` set; carries `wire_id` + name
//         (first sighting in this session).
//       - **Bare**: flags == 0; carries `wire_id` + new value (channel
//         already known to the client).
//       - **Remove**: bit 1 of `flags` set; carries `wire_id` only;
//         tells the client "this channel is no longer visible — drop
//         your cached value."
//   * Steady-state: only entries whose value changed since the last
//     batch ship. Empty deltas are skipped entirely.
//
// `dict_seq` is monotonic per session; the client gates reads on
// `dict_seq >= last_accepted` and triggers a full resync (drop the
// inbound dict + reset state) on backwards drift.
//
// `batch_seq` is monotonic across all batches the server sent on this
// session. The client uses it for diagnostics + as the resync hint
// it returns in the future ack message.
//
// **Why TCP, not UDP**: HUD deltas are stateful (each delta builds on
// prior state via the dict). A single dropped UDP datagram requires
// resync. TCP's reliability lets us delete the snapshot path entirely
// without per-message recovery.
// ---------------------------------------------------------------------------

table HudSignalEntryV2 {
    /// Bit 0 = REGISTER (carries name); bit 1 = REMOVE (drops the
    /// wire_id from the client's cache). Bits 2-7 reserved.
    flags: uint8;
    /// Per-session dictionary id for this channel. Allocated by the
    /// server's `HudSession::OutboundDict`.
    wire_id: uint32;
    /// Channel name. Required when flags & REGISTER. Empty otherwise
    /// (clients MUST gate name use on the flag, not on string
    /// non-emptiness).
    channel_name: string;
    /// 0=Bool, 1=Float, 2=State, 3=Text. Same encoding as V1
    /// `HudSignalEntry`. Ignored on REMOVE.
    value_type: uint8;
    value_num: float;
    /// Populated only when `value_type == 3`.
    value_text: string;
    /// `SignalProperty` ordinal (matches V1's `property` field).
    property: uint8;
    /// Per-(session, wire_id) monotonic seq. Lets the client detect
    /// out-of-order delivery within a single session if/when we
    /// add UDP fast-path for non-stateful HUD entries (deferred).
    seq: uint32;
}

table HudSignalDelta {
    /// Per-session monotonic dictionary sequence. Bumped on every
    /// REGISTER + every REMOVE. Client verifies `>=` last accepted.
    dict_seq: uint64;
    /// Per-session monotonic batch sequence. Strictly increasing.
    batch_seq: uint64;
    entries: [HudSignalEntryV2];
}

table WorldState {
    tick: uint64;
    origin: Vec3d;
    /// Deprecated: kept for one version during migration to `entities`.
    /// New code should read `entities` for all observable entities.
    players: [PlayerSnapshot];
    bodies: [CelestialBodySnapshot];
    /// Deprecated: kept for one version during migration to `entities`.
    /// New code should read `entities` for ships.
    ships: [ShipSnapshotEntry];
    lighting: LightingInfoMsg;
    game_time: double;
    warp_target_star_index: uint32 = 4294967295;
    autopilot: AutopilotSnapshot;
    sub_grids: [SubGridTransform];
    /// Unified observable entities (ships, players, EVA) with LOD tiers.
    /// Source-of-truth going forward. The legacy `ships`/`players` fields
    /// will be removed once all shards and clients migrate.
    entities: [ObservableEntity];
    // Phase 4.4.5: `hud_signals: [HudSignalEntry]` removed. Replaced
    // by the TCP `HudSignalDelta` server message — only changed
    // entries ship, never per-tick full-snapshot UDP. See
    // `core::signal::hud_session` and the `ServerMsg::HudSignalDelta`
    // path in `client_message.rs`.
}

/// Block-to-sub-grid assignment for mechanical mount membership.
table SubGridBlockAssignment {
    bx: int32;
    by: int32;
    bz: int32;
    sub_grid_id: uint32;  // 0 = root (unassign)
}

/// Reliable (TCP) update of sub-grid block assignments.
/// Sent on player join (full state) and on membership change (delta).
table SubGridAssignmentUpdate {
    assignments: [SubGridBlockAssignment];
}

table BlockMod {
    bx: uint8;
    by: uint8;
    bz: uint8;
    block_type: uint16;
}

table ChunkBlockMods {
    sector: uint8;
    shell: uint16;
    cx: uint16;
    cy: uint16;
    cz: uint16;
    seq: uint64;
    mods: [BlockMod];
}

table BlockEditRequest {
    action: uint8; // 1=break, 2=place
    eye_x: double;
    eye_y: double;
    eye_z: double;
    look_x: double;
    look_y: double;
    look_z: double;
    block_type: uint16;
}

/// Sub-block element modification within a chunk delta.
table SubBlockMod {
    bx: uint8;
    by: uint8;
    bz: uint8;
    face: uint8;
    element_type: uint8;
    rotation: uint8;
    action: uint8;  // 0=remove, 1=place
}

/// Client → server: place or remove a sub-block element.
table SubBlockEditRequest {
    /// Host block world position (signed, ship-local or planet-space).
    block_x: int32;
    block_y: int32;
    block_z: int32;
    face: uint8;          // 0-5: which face of the host block
    element_type: uint8;  // SubBlockType discriminant
    rotation: uint8;      // 0-3: rotation on face
    action: uint8;        // action::PLACE_SUB or action::REMOVE_SUB
}

/// Generic chunk address using signed 32-bit Cartesian coordinates.
/// Works for both ship grids (direct IVec3) and planets (derived from cubic sphere).
/// This is the unified address format used by ChunkSnapshot and ChunkDelta.
struct ChunkAddr {
    x: int32;
    y: int32;
    z: int32;
}

/// Per-placed-lamp configuration broadcast alongside chunk data.
///
/// One entry per `(host_block_pos, face)` lamp the player has
/// customised on the ship. Stored server-side in
/// `ShipGrid.lamp_configs`; the server emits the entries that fall
/// inside the chunk's coordinate bounds when serialising the
/// `ChunkSnapshot` / `ChunkDelta`. Clients keep a parallel
/// `LampConfigs` resource keyed by `(shard, block_pos, face)` and the
/// sub-block lamp spawn reads from it.
///
/// Empty `subscribe_channel` / `publish_channel` strings mean
/// "unbound" — the lamp ignores any signal modulation and just emits
/// at `intensity_scale × LightSpec.lumens`.
table LampConfigEntry {
    /// Block-local coordinate within the chunk (0..62 each axis).
    bx: ubyte;
    by: ubyte;
    bz: ubyte;
    /// Sub-block face (0..6: ±X, ±Y, ±Z).
    face: ubyte;
    /// Channel the lamp's intensity scales with. Empty = unmodulated.
    subscribe_channel: string;
    /// Channel the lamp publishes its `Active` state to. Empty = none.
    publish_channel: string;
    /// Override blackbody temperature for the bulb colour.
    color_kelvin: float;
    /// Multiplicative tint applied on top of the blackbody colour.
    tint_r: float;
    tint_g: float;
    tint_b: float;
    /// Multiplier on `LightSpec.lumens`. 1.0 = stock, 0.0 = off.
    intensity_scale: float;
}

/// Full chunk snapshot — lz4-compressed block data + metadata.
/// Sent on initial connection and periodic resync. Replaces the chunk entirely.
table ChunkSnapshot {
    addr: ChunkAddr;
    seq: uint64;
    /// lz4-compressed chunk data (palette + indices + metadata).
    /// Decompresses to the format produced by core::block::serialization.
    data: [uint8];
    /// Per-placed-lamp configs that fall inside this chunk's bounds.
    /// Empty when no lamp has been customised in the chunk.
    lamp_configs: [LampConfigEntry];
}

/// Incremental block changes to a chunk (generic, shard-type agnostic).
/// Sent when blocks are placed, broken, or modified by gameplay systems.
table ChunkDelta {
    addr: ChunkAddr;
    seq: uint64;
    mods: [BlockMod];
    sub_block_mods: [SubBlockMod];
    /// Lamp config additions / replacements for this chunk. The
    /// server sends a delta entry whenever a player edits a lamp
    /// through the F-key panel; the client applies in-place.
    lamp_configs: [LampConfigEntry];
}

table ShardRedirectMsg {
    session_token: uint64;
    target_tcp_addr: string;
    target_udp_addr: string;
    shard_id: uint64;
    /// Shard type of the destination (0=Planet, 1=System, 2=Ship, 3=Galaxy).
    /// Lets the client pick the correct pending secondary for seamless
    /// promotion when multiple secondaries of different types are connected
    /// (e.g., Ship + Galaxy), instead of relying on last-writer-wins state.
    target_shard_type: uint8 = 255;
    /// Authoritative spawn pose on the destination shard. The source shard
    /// computes these using the same formula the target will use to spawn
    /// the player (e.g., ship-exit: `exterior.position + exterior.rotation
    /// * player_local`). Client uses these directly for its first rendered
    /// frame after the transition, eliminating the need for client-side
    /// fallback prediction that was visibly off by orbital drift (~15 km)
    /// and by hull interior/exterior confusion.
    ///
    /// `has_spawn_pose = false` means legacy sender / initial gateway
    /// routing that has no natural spawn pose (client falls back to its
    /// existing post-connect JoinResponse position).
    has_spawn_pose: bool = false;
    spawn_system_position: Vec3d;
    spawn_rotation: Quatd;
    spawn_velocity: Vec3d;
}

/// Seamless handoff: client promotes an existing secondary connection to primary.
/// Replaces ShardRedirectMsg for shard-to-shard transitions (launch, land, board, warp).
/// Requires the destination shard to already be streaming to the client as a secondary
/// and to have spawned a PendingOwnership observer entity for this session_token.
/// The destination shard flips observer → owned on receipt of the source shard's
/// HandoffAccepted / PlayerHandoff pair.
table ShardHandoffMsg {
    session_token: uint64;
    /// Which currently-active secondary the client should promote.
    /// (0=Planet, 1=System, 2=Ship, 3=Galaxy)
    promote_shard_type: uint8;
    /// Shard ID of the secondary to promote (disambiguates multiple of same type).
    promote_shard_id: uint64;
    /// TCP address of the destination shard (for client input redirection).
    /// May match an already-open secondary TCP — client reuses the existing stream.
    target_tcp_addr: string;
    /// UDP address of the destination shard.
    target_udp_addr: string;
    /// How long the source shard will keep ghosting this player (ticks).
    source_demote_after_ticks: uint8 = 15;
    /// Anchor at handoff tick in destination-frame coordinates
    /// (client uses this for a short interpolation blend across the switch).
    handoff_position: Vec3d;
    handoff_velocity: Vec3d;
    handoff_rotation: Quatd;
}

/// Pre-connect notification: shard tells client to open a secondary connection.
table ShardPreConnect {
    shard_type: uint8;         // 0=Planet, 1=System, 2=Ship, 3=Galaxy
    tcp_addr: string;
    udp_addr: string;
    seed: uint64;              // planet_seed, system_seed, or galaxy_seed
    planet_index: uint32;
    reference_position: Vec3d; // system-space position
    reference_rotation: Quatd;
    shard_id: uint64;          // Shard ID for multi-secondary disambiguation
}

/// Server → client: tear down a specific secondary connection.
table ShardDisconnectNotify {
    shard_type: uint8;
    seed: uint64;              // ship_id for ship shards, planet_seed for planets
}

/// World state for galaxy shard → client (warp travel).
table GalaxyWorldState {
    tick: uint64;
    ship_position: Vec3d;      // in galaxy units
    ship_velocity: Vec3d;      // in galaxy units/s
    ship_rotation: Quatd;
    warp_phase: uint8;         // FlightPhase as u8
    eta_seconds: double;
    origin_star_index: uint32;
    target_star_index: uint32;
}

table DamageEvent {
    target_id: uint64;
    source_id: uint64;
    damage: float;
    weapon_type: uint8;
}

table PlayerDestroyed {
    player_id: uint64;
    killer_id: uint64;
    position: Vec3d;
}

/// Signal binding: maps a channel name to a block property.
table SignalBindingFB {
    channel_name: string;
    property: uint8;   // SignalProperty enum
    // Phase C — scope hint when the binding triggers fresh channel
    // creation. Ignored when the named channel already exists
    // (channel scope is set at create time and immutable).
    //   0 = unspecified → server creates as `Local` (matches
    //       pre-Phase-C behaviour; backward compat with old
    //       client payloads that don't set the field).
    //   1 = ShortRange (range_m carries the radius).
    //   2 = LongRange.
    //   3 = Radio (frequency carries the frequency).
    scope_code: uint8 = 0;
    /// ShortRange: physical radius in meters. Other scopes: 0.
    range_m: float = 0;
    /// Radio: frequency. Other scopes: 0.
    frequency: uint32 = 0;
    /// Phase D — held-grant id when the binding targets a keyed
    /// remote channel (typically scope_code=3 Radio). 0 ⇒ no grant
    /// (open channel, in-shard binding, or grant not yet picked).
    /// Server validates: required iff resolved channel is keyed.
    grant_id: uint64 = 0;
}

/// Per-block-kind allowed property descriptor used by the configurator UI
/// dropdown. Server populates from the kind's static `BlockKindSignalSchema`;
/// client uses to filter what options to render. Keeps the wire compact:
/// just the ordinal + a short hint text for the tooltip.
table PropertyOptionFB {
    ordinal: uint8;     // SignalProperty as_ordinal
    hint: string;       // Optional human-readable tooltip; "" for none
}

/// Signal converter rule: condition → action.
table SignalRuleFB {
    input_channel: string;
    condition_type: uint8;    // 0=GreaterThan, 1=LessThan, 2=Equals, 3=NotEquals, 4=Changed, 5=Always
    condition_value: float;
    output_channel: string;
    expression_type: uint8;   // 0=Constant, 1=PassThrough, 2=Invert, 3=Scale, 4=Clamp
    expression_value: float;  // for Constant (bool as 0/1), Scale factor
    expression_value2: float; // for Clamp max
}

/// Generic seat input binding.
table SeatBindingFB {
    label: string;
    source: uint8;           // SeatInputSource: 0=Key, 1=MouseX, 2=MouseY, 3=Scroll
    key_name: string;        // Platform-independent key name (Key source only)
    key_mode: uint8;         // KeyMode: 0=Momentary, 1=Toggle
    axis_direction: uint8;   // AxisDirection: 0=Positive, 1=Negative, 2=Both
    channel_name: string;
    property: uint8;         // SignalProperty enum
}

// -------------------------------------------------------------------
// Custom ship system block configs (each block has its own table)
// -------------------------------------------------------------------

table FlightComputerConfigFB {
    yaw_cw_channel: string;
    yaw_ccw_channel: string;
    pitch_up_channel: string;
    pitch_down_channel: string;
    roll_cw_channel: string;
    roll_ccw_channel: string;
    toggle_channel: string;
    damping_gain: float = 0.6;
    dead_zone: float = 0.005;
    max_correction: float = 0.3;
}

table HoverModuleConfigFB {
    thrust_forward_channel: string;
    thrust_reverse_channel: string;
    thrust_right_channel: string;
    thrust_left_channel: string;
    thrust_up_channel: string;
    thrust_down_channel: string;
    yaw_cw_channel: string;
    yaw_ccw_channel: string;
    pitch_up_channel: string;
    pitch_down_channel: string;
    roll_cw_channel: string;
    roll_ccw_channel: string;
    activate_channel: string;
    cutoff_channel: string;
}

table AutopilotConfigFB {
    yaw_cw_channel: string;
    yaw_ccw_channel: string;
    pitch_up_channel: string;
    pitch_down_channel: string;
    roll_cw_channel: string;
    roll_ccw_channel: string;
    engage_channel: string;
}

table WarpComputerConfigFB {
    cycle_channel: string;
    accept_channel: string;
    cancel_channel: string;
}

table EngineControllerConfigFB {
    thrust_forward_channel: string;
    thrust_reverse_channel: string;
    thrust_right_channel: string;
    thrust_left_channel: string;
    thrust_up_channel: string;
    thrust_down_channel: string;
    yaw_cw_channel: string;
    yaw_ccw_channel: string;
    pitch_up_channel: string;
    pitch_down_channel: string;
    roll_cw_channel: string;
    roll_ccw_channel: string;
    toggle_channel: string;
}

/// Phase 3E: Antenna block config — bridges a Local channel on this shard
/// to a Radio channel on a target shard via a held grant. The placing
/// player's `HeldGrants[grant_id]` provides the HMAC key (looked up at
/// apply time, then cached on `AntennaState` for the per-tick hot path).
///
/// LEGACY shape — retained for one migration window. New code emits
/// `AntennaConfigFB` (bidirectional). Server reads this on load and
/// rewrites it into the bidirectional form (TX side only). Removed in
/// the Phase 6 cleanup.
table LegacyAntennaConfigFB {
    /// Local channel the antenna READS each tick.
    source_channel_name: string;
    /// Remote channel name on the target shard (the publish target).
    remote_channel_name: string;
    frequency: uint32;
    grant_id: uint64;
    target_shard_id: uint64;
}

/// LEGACY shape — Listener block. Retained for one migration window.
/// Server rewrites into a bidirectional `AntennaConfigFB` with only
/// the RX side populated. Removed in the Phase 6 cleanup.
table LegacyListenerConfigFB {
    destination_channel_name: string;
    bridged_channel_name: string;
    frequency: uint32;
    grant_id: uint64;
    source_shard_id: uint64;
}

/// One side of a bidirectional Antenna bridge. The struct is symmetric
/// for TX and RX — direction is implicit from which slot in
/// `AntennaConfigFB` carries it. Empty `local_channel_name` means
/// "this side is unused" (used to express tx-only or rx-only antennas
/// since FB doesn't have native Option-of-table for `optional struct`).
table AntennaSideFB {
    /// Local channel:
    ///   * TX: antenna SUBSCRIBES to this channel; values are forwarded
    ///     to `frequency` each tick.
    ///   * RX: antenna PUBLISHES values it receives on `frequency` to
    ///     this channel.
    /// Empty means "side unused".
    local_channel_name: string;

    /// Radio frequency. Routing target.
    frequency: uint32 = 0;

    /// Optional held-grant id. 0 ⇒ open radio (channel has
    /// `auth: ChannelAuth::None`). Non-zero ⇒ keyed; server checks
    /// the grant in the placing player's HeldGrants and verifies
    /// it covers the resolved remote channel with the right ops.
    grant_id: uint64 = 0;

    /// Where the remote channel lives. 0 ⇒ orchestrator-routed via
    /// the relay (per the existing frequency-band table).
    remote_shard_id: uint64 = 0;
}

/// Bidirectional Antenna config. At least one side must have a
/// non-empty `local_channel_name` — server rejects zero-side configs.
/// Most antennas use BOTH sides (full-duplex chat at one frequency);
/// uni-directional antennas (TX-only beacon, RX-only listener) leave
/// one side empty.
table AntennaConfigFB {
    tx: AntennaSideFB;
    rx: AntennaSideFB;
}

/// Per-side access status for the configurator UI. Server populates
/// this from the resolved remote channel (via the grant lookup or the
/// orchestrator's relay table) so the client can render the right
/// affordance: open caption, held-grants dropdown, or "Request access".
table AccessStatusForChannelFB {
    /// True if the resolver knows about a remote channel for this
    /// (frequency, remote_shard_id). False ⇒ "no channel known yet"
    /// (client shows freq input only).
    remote_channel_known: bool = false;
    /// True if the remote channel is keyed (`ChannelAuth::Hmac`).
    auth_required: bool = false;
    /// Held grants the placing player has that cover the resolved
    /// channel + the relevant op (Publish for TX, Subscribe for RX).
    held_grants: [HeldGrantSummaryFB];
}

/// Compact summary of a held grant for picker dropdowns. The grant
/// key itself is never sent to the client UI — only the picker id
/// + label + expiry + ops bitmap.
table HeldGrantSummaryFB {
    grant_id: uint64;
    label: string;
    /// 0 ⇒ no expiry; otherwise unix-ms.
    expires_at_ms: uint64 = 0;
    /// Bit 0 = Publish, bit 1 = Subscribe.
    ops_mask: uint8 = 0;
}

/// Unified Terminal block config — replaces TextDisplayState +
/// KeyboardTerminalState wire shapes. A Terminal can subscribe (read),
/// publish (write), or both. At least one channel must be set; server
/// rejects fully-empty configs.
table TerminalConfigFB {
    /// Channel this terminal subscribes to. Inbound text frames
    /// scroll the in-world surface. Empty ⇒ input-only kiosk
    /// (e.g., emergency-call panel).
    subscribe_channel_name: string;

    /// Channel this terminal publishes to on E-key send. Empty ⇒
    /// read-only sign / status board.
    publish_channel_name: string;

    /// Maximum scrollback lines retained on the entity. 0 ⇒ apply
    /// the registry default.
    scrollback_lines: uint16 = 0;
}

/// Server → client: seat bindings when player enters a seat.
table SeatBindingsNotify {
    bindings: [SeatBindingFB];
    seated_channel_name: string;
}

/// A named power circuit on a reactor (fraction of total output).
table PowerCircuitFB {
    name: string;
    fraction: float;        // 0.0–1.0
}

/// Reactor power source configuration.
table PowerSourceConfigFB {
    circuits: [PowerCircuitFB];
    access_mode: uint8;     // 0=OwnerOnly, 1=AllowList, 2=Open
    allow_list: [string];   // player names (only if access_mode=1)
}

/// Consumer power subscription (which reactor + circuit).
table PowerConsumerConfigFB {
    reactor_x: int32;
    reactor_y: int32;
    reactor_z: int32;
    has_reactor: bool;      // false = no reactor selected
    circuit: string;
}

/// Info about a nearby reactor (for consumer dropdown in config UI).
table NearbyReactorFB {
    pos_x: int32;
    pos_y: int32;
    pos_z: int32;
    label: string;          // e.g., "Small Reactor"
    distance: float;
    circuits: [string];
}

/// Server → client: current signal config for a functional block.
table BlockConfigState {
    block_x: int32;
    block_y: int32;
    block_z: int32;
    block_type: uint16;
    kind: uint8;
    publish_bindings: [SignalBindingFB];
    subscribe_bindings: [SignalBindingFB];
    converter_rules: [SignalRuleFB];
    seat_mappings: [SeatBindingFB];
    available_channels: [string];
    power_source: PowerSourceConfigFB;
    power_consumer: PowerConsumerConfigFB;
    nearby_reactors: [NearbyReactorFB];
    seated_channel_name: string;
    flight_computer_config: FlightComputerConfigFB;
    hover_module_config: HoverModuleConfigFB;
    autopilot_config: AutopilotConfigFB;
    warp_computer_config: WarpComputerConfigFB;
    engine_controller_config: EngineControllerConfigFB;
    /// Properties this block kind can publish (configurator UI dropdown).
    /// Empty if the block doesn't publish at all (e.g., Thruster).
    publish_property_options: [PropertyOptionFB];
    /// Properties this block kind can subscribe to.
    subscribe_property_options: [PropertyOptionFB];
    /// Phase D: Antenna block config (None on non-antenna blocks).
    /// Bidirectional shape; legacy uni-directional rows are migrated
    /// at boot and never appear here.
    antenna_config: AntennaConfigFB;
    /// Phase D: Per-side access status for the configurator UI —
    /// renders the right grant affordance (open / picker / request).
    /// Server-populated; ignored on the inbound update path.
    antenna_tx_status: AccessStatusForChannelFB;
    antenna_rx_status: AccessStatusForChannelFB;
    /// Phase D: Unified Terminal block config (None on non-terminal
    /// blocks).
    terminal_config: TerminalConfigFB;
    /// Phase D: Held-grant summaries for the configurator's binding
    /// rows that target Radio scope. Picker dropdown sources its
    /// options from this snapshot.
    held_grants: [HeldGrantSummaryFB];
}

/// Client → server: updated signal config for a functional block.
table BlockConfigUpdate {
    block_x: int32;
    block_y: int32;
    block_z: int32;
    publish_bindings: [SignalBindingFB];
    subscribe_bindings: [SignalBindingFB];
    converter_rules: [SignalRuleFB];
    seat_mappings: [SeatBindingFB];
    power_source: PowerSourceConfigFB;
    power_consumer: PowerConsumerConfigFB;
    seated_channel_name: string;
    flight_computer_config: FlightComputerConfigFB;
    hover_module_config: HoverModuleConfigFB;
    autopilot_config: AutopilotConfigFB;
    warp_computer_config: WarpComputerConfigFB;
    engine_controller_config: EngineControllerConfigFB;
    /// Phase D: Antenna block config (None on non-antenna blocks).
    /// Bidirectional shape.
    antenna_config: AntennaConfigFB;
    /// Phase D: Unified Terminal block config (None on non-terminal
    /// blocks).
    terminal_config: TerminalConfigFB;
}

// ---------------------------------------------------------------------------
// Phase 3C: capability-based grants on signal channels (RemoteAccessGrant)
// ---------------------------------------------------------------------------

/// Client → server: create a grant on one or more channels owned by the
/// requesting player. Server validates ownership, allocates `grant_id` +
/// HMAC key via OsRng, inserts into the shard's `GrantsRegistry`, and
/// replies with a `GrantsSnapshotData` containing the new entry's key.
table GrantCreate {
    /// Channels this grant covers, by full namespaced display name (e.g.,
    /// "12345.thrust-forward"). Server resolves to ChannelIds.
    channel_names: [string];
    /// 0=Publish, 1=Subscribe, 2=Both.
    ops: uint8;
    /// Human-readable label shown in the owner's Access Tokens panel
    /// ("Bob (remote pilot)"). Up to 64 chars.
    label: string;
    /// UNIX millis when the grant auto-revokes. 0 = no expiration.
    expires_at_ms: uint64 = 0;
    /// Optional namespace pattern for auto-extension (e.g.,
    /// "alice.north-pad.*"). Empty = no glob.
    namespace_glob: string;
}

/// Client → server: revoke an existing grant. Idempotent — already-revoked
/// grants reply success. The grant is tombstoned (kept for audit) rather
/// than removed.
table GrantRevoke {
    grant_id: uint64;
}

/// One row of `GrantsSnapshotData`. Contains everything the owner-side
/// tablet UI needs to render the Access Tokens panel.
table GrantPublicView {
    grant_id: uint64;
    /// Base64-encoded 32-byte HMAC key. **Sent only to the grant's owner.**
    /// Non-owner snapshot recipients (other players in the same shard)
    /// receive an empty string here — never the raw key.
    key_b64: string;
    /// Resolved channel display names.
    channel_names: [string];
    /// 0=Publish, 1=Subscribe, 2=Both.
    ops: uint8;
    label: string;
    created_at_ms: uint64;
    /// 0 = no expiration; otherwise UNIX millis.
    expires_at_ms: uint64 = 0;
    created_by: uint64;
    revoked: bool;
    namespace_glob: string;
}

/// Server → client: full snapshot of the player's owned grants. Sent on
/// any GrantCreate / GrantRevoke that mutated the registry. Replaces (not
/// merges) the client's state — the snapshot is authoritative.
table GrantsSnapshotData {
    grants: [GrantPublicView];
}

/// Phase D: server → client "engage device" message. Sent in response
/// to E (INTERACT) on a Terminal block. Carries everything the
/// client needs to open the in-world chat surface: which block, what
/// channels are wired, and the current scrollback so the player sees
/// recent traffic immediately.
table OpenTerminalChatData {
    block_x: int32;
    block_y: int32;
    block_z: int32;
    /// Empty string ⇒ no read side configured (input-only kiosk).
    subscribe_channel: string;
    /// Empty string ⇒ no write side configured (read-only sign).
    publish_channel: string;
    /// Most-recent scrollback at engagement time. Bounded by the
    /// terminal's max_lines (default 64). Subsequent updates flow as
    /// `TerminalScrollbackDelta`.
    recent_lines: [string];
}

/// Phase D: server → client real-time scrollback update.  Pushed each
/// time a Terminal's `recent_lines` changes (a new media frame
/// arrived on its subscribe channel) AND the player is engaged with
/// that terminal. The client appends to the local cached scrollback,
/// ring-buffered to the terminal's max_lines.
table TerminalScrollbackDeltaData {
    block_x: int32;
    block_y: int32;
    block_z: int32;
    appended_lines: [string];
}

union ServerPayload {
    JoinResponse,
    WorldState,
    ChunkBlockMods,
    ShardRedirectMsg,
    DamageEvent,
    PlayerDestroyed,
    StarCatalog,
    ShardPreConnect,
    GalaxyWorldState,
    ChunkSnapshot,
    ChunkDelta,
    BlockConfigState,
    SeatBindingsNotify,
    SubGridAssignmentUpdate,
    ShardDisconnectNotify,
    /// Seamless promotion handoff (replaces ShardRedirectMsg for in-game transitions).
    ShardHandoffMsg,
    /// Phase 3C: full snapshot of the player's owned RemoteAccessGrants.
    GrantsSnapshotData,
    /// Phase 4.4: delta-encoded HUD signal updates.
    HudSignalDelta,
    /// Phase D: open the in-world Terminal chat surface.
    OpenTerminalChatData,
    /// Phase D: append lines to a Terminal's scrollback while engaged.
    TerminalScrollbackDeltaData,
}

/// Root type for server → client messages.
table ServerMessage {
    payload: ServerPayload;
}

/// Client → server: open an observer-only connection (no player entity).
/// Used for dual-shard compositing: the client receives chunk data and
/// WorldState broadcasts but does not participate in gameplay.
table ObserverConnect {
    observer_name: string;     // optional, for debugging/logging
}

/// Client → server: publish a signal value to a channel. The server
/// validates `publish_policy` against the sender's player_id before
/// accepting. Used by publisher HUD widgets (buttons, sliders,
/// toggles) painted on in-world HUD panels. No `Text` publish —
/// string signals are server-authored only.
///
/// Value encoding matches `HudSignalEntry` for types 0-2 (Bool, Float,
/// State).
table ClientSignalPublish {
    channel_name: string;
    value_type: uint8;
    value_data: float;
}

/// Client → server: updated config for a sub-block lamp at
/// `(block_x, block_y, block_z, face)`. Sent when the player saves
/// changes through the F-key lamp config panel. The server validates,
/// stores in `ShipGrid.lamp_configs`, and rebroadcasts via the
/// chunk's next snapshot / delta so every connected client sees the
/// new colour / channel binding.
table LampConfigUpdate {
    block_x: int32;
    block_y: int32;
    block_z: int32;
    face: ubyte;
    config: LampConfigEntry;
}

/// Client → server: register a held grant locally so subsequent
/// `RemoteSignalPublish`es can use it. The player received `(grant_id,
/// key_b64)` out-of-band (Discord, in-game mail) and pastes them via
/// the tablet's "Add grant" UI.
table AddHeldGrant {
    /// Grant id minted by the issuing shard. Must match the recipient's
    /// expected target.
    grant_id: uint64;
    /// Base64 32-byte HMAC key.
    key_b64: string;
    /// Shard id that issued the grant (the receiver of any future
    /// `RemoteSignalPublish` using this grant).
    target_shard_id: uint64;
    /// User-facing label so the tablet UI can show "from Alice (Caraval)".
    label: string;
}

/// Client → server: forget a previously-added held grant. Idempotent.
table ForgetHeldGrant {
    grant_id: uint64;
}

/// Client → server: publish a value to a remote channel via a held grant.
/// The player's primary shard signs HMAC over the canonicalized payload
/// using the held grant's key, then ships the resulting
/// `SignalBroadcastBatch` via QUIC to `target_shard_id`. Receiver verifies
/// via `try_push_remote` against `GrantsRegistry::check_publish`.
table RemoteSignalPublish {
    target_shard_id: uint64;
    channel_name: string;
    grant_id: uint64;
    /// Signal value type: 0=Bool, 1=Float, 2=State.
    value_type: uint8;
    value_data: float;
}

/// Phase D: client → server "user typed a line on the in-world Terminal".
/// Server's INTERACT path turns this into a `KeyboardTerminalInput`
/// event consumed by `terminal_publish`, which signs (or sends bare for
/// open channels) and ships the media frame.
table TerminalChatSendData {
    block_x: int32;
    block_y: int32;
    block_z: int32;
    /// Single line, ≤ 4 KiB (matches MediaPayload::Text size cap).
    text: string;
}

union ClientPayload {
    Connect,
    PlayerInput,
    BlockEditRequest,
    BlockConfigUpdate,
    SubBlockEditRequest,
    ObserverConnect,
    ClientSignalPublish,
    LampConfigUpdate,
    /// Phase 3C: create a new RemoteAccessGrant on owned channels.
    GrantCreate,
    /// Phase 3C: revoke a previously-issued grant.
    GrantRevoke,
    /// Phase 3C: register a held grant (recipient-side).
    AddHeldGrant,
    /// Phase 3C: forget a held grant (recipient-side).
    ForgetHeldGrant,
    /// Phase 3C: publish to a remote channel via a held grant.
    RemoteSignalPublish,
    /// Phase D: send a chat line typed on an engaged Terminal block.
    TerminalChatSendData,
    /// Phase J: open or close a tablet on a functional block.
    TabletInteractRequest,
    /// Phase J: high-frequency cursor position update during the
    /// tablet hold (server passes through to broadcast for remote
    /// finger-IK replication; never read for gameplay decisions).
    TabletCursorUpdate,
}

/// Phase J: client opens / closes a held tablet.
///
/// `Open` requires `block_x/y/z` to identify the functional block
/// being interacted with — server validates the target exists, is
/// interactive, and the player is within range before inserting
/// `IsHoldingTablet` on the character. `Close` ignores those fields.
table TabletInteractRequest {
    /// 1 = open, 2 = close.
    action: uint8;
    /// Functional block coordinates in the player's authoritative
    /// shard (ship-local or planet-local i32). Ignored when
    /// `action == 2`.
    block_x: int32 = 0;
    block_y: int32 = 0;
    block_z: int32 = 0;
}

/// Phase J: cursor position on the held tablet's screen, in UV
/// space `[0, 1]`. Sent at ~20 Hz (throttled client-side); server
/// clamps to range and broadcasts via `PlayerSnapshot.tablet_cursor_*`
/// for remote finger-IK replication.
table TabletCursorUpdate {
    u: float;
    v: float;
}

/// Root type for client → server messages.
table ClientMessage {
    payload: ClientPayload;
}

root_type ShardMessage;
